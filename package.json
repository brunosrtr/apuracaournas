{
  "name": "apuracao-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apuração das Eleições 2026 em tempo real com projeção estatística baseada em dados históricos do TSE",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dados": "node server/dados/preparar.ts",
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "servidor": "node server/index.ts",
    "testar": "node server/modelo/testes.ts",
    "tipos": "tsc --noEmit -p ."
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
